{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "tests 'games'",
            "cargo": {
                "args": ["test", "--no-run", "--bin=games", "--package=games"],
                "filter": {
                    "name": "games",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach to 'games'",
            "program": "${workspaceFolder}/target/debug/games",
            "pid": "${command:pickProcess}",
            "waitFor": true
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug 'games'",
            "preLaunchTask": "cargo build",
            "program": "${workspaceFolder}/target/debug/games",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug release 'games'",
            "preLaunchTask": "cargo build release",
            "program": "${workspaceFolder}/target/release/games",
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}